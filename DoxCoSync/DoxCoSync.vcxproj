    <!-- Deploy DLL + ESP + PEX to Fallout 4 Data directory after a Release build.
         Requires FO4DataDir to point at a valid FO4 installation.
         Override FO4DataDir in a user .props file if needed. -->
    <PostBuildEvent>
      <Message>Deploying DoxCoSync to $(FO4DataDir)</Message>
      <Command>
if not exist "$(FO4DataDir)\F4SE\Plugins" mkdir "$(FO4DataDir)\F4SE\Plugins"
copy /Y "$(TargetPath)" "$(FO4DataDir)\F4SE\Plugins\$(TargetName).dll"
if exist "$(TargetDir)$(TargetName).pdb" copy /Y "$(TargetDir)$(TargetName).pdb" "$(FO4DataDir)\F4SE\Plugins\$(TargetName).pdb"
set "_pcomp=$(PapyrusCompilerPath)"
set "_pout=$(PapyrusOutputDir)"
set "_pflags=$(PapyrusFlagsFile)"
set "_pi=$(PapyrusDataDir)\Source;$(PapyrusDataDir)\Source\Base;$(PapyrusDataDir)\Scripts"
if exist "%_pcomp%" "%_pcomp%" "CoSyncQuest" "-f=%_pflags%" "-i=%_pi%" "-o=%_pout%"
if exist "%_pcomp%" "%_pcomp%" "CoSyncPlayer" "-f=%_pflags%" "-i=%_pi%" "-o=%_pout%"
if exist "$(PapyrusOutputDir)\CoSync.pex" copy /Y "$(PapyrusOutputDir)\CoSync.pex" "$(FO4DataDir)\Scripts\CoSync.pex"
if exist "$(PapyrusOutputDir)\CoSyncQuest.pex" copy /Y "$(PapyrusOutputDir)\CoSyncQuest.pex" "$(FO4DataDir)\Scripts\CoSyncQuest.pex"
if exist "$(PapyrusOutputDir)\CoSyncPlayer.pex" copy /Y "$(PapyrusOutputDir)\CoSyncPlayer.pex" "$(FO4DataDir)\Scripts\CoSyncPlayer.pex"
if exist "$(SolutionDir)F4se-Data\Data\CoSync.esp" copy /Y "$(SolutionDir)F4se-Data\Data\CoSync.esp" "$(FO4DataDir)\CoSync.esp"
rem GameNetworkingSockets runtime (+ abseil/libcrypto/libprotobuf). F4SE loads
rem plugins with plain LoadLibrary, so these are resolved from the GAME ROOT
rem (exe dir), not from F4SE\Plugins. A game reinstall/update wiped them on
rem 2026-09-22 and DoxCoSync failed to load with error 126. Copy only if missing.
for %%D in (GameNetworkingSockets.dll abseil_dll.dll libcrypto-3-x64.dll libprotobuf.dll) do if not exist "$(FO4DataDir)\..\%%D" if exist "$(ProjectDir)F4se-Data\GameRoot\%%D" copy "$(ProjectDir)F4se-Data\GameRoot\%%D" "$(FO4DataDir)\..\%%D"
rem PrismaUI views (HTML/CSS/JS/fonts) -> Data\PrismaUI_F4\views\DoxCoSync\
if exist "$(ProjectDir)F4se-Data\Data\PrismaUI_F4\views\DoxCoSync" xcopy /E /Y /I "$(ProjectDir)F4se-Data\Data\PrismaUI_F4\views\DoxCoSync" "$(FO4DataDir)\PrismaUI_F4\views\DoxCoSync\"
rem CoSync.ini: deliberately NOT /Y -- this is user-editable config, so ship the
rem default once and never overwrite a local change on a later rebuild.
if not exist "$(FO4DataDir)\F4SE\Plugins\CoSync.ini" if exist "$(SolutionDir)F4se-Data\Data\F4SE\Plugins\CoSync.ini" copy "$(SolutionDir)F4se-Data\Data\F4SE\Plugins\CoSync.ini" "$(FO4DataDir)\F4SE\Plugins\CoSync.ini"
rem 2026-07-21: RE-ENABLED with a fundamentally different, safer technique.
rem The original approach (hand-assembled minimal NiNode from scratch, no
rem validation tooling) hung the game the first time it went live -- see
rem CHANGELOG [0.0.39]/[0.0.40]. Replaced entirely: these 91 files are the
rem REAL game meshes extracted directly from Fallout4 - Meshes.ba2/
rem MeshesExtra.ba2 (a hand-written BA2 reader, not a NIF writer), with only
rem the root NiNode's scale float overwritten to 0.0 in place -- header,
rem block table, and all other bytes are byte-identical to the shipped game
rem asset. Each patch site was verified against the expected post-scale
rem byte shape (collision ref + plausible child count) before being
rem accepted; 6 candidates that didn't match were left untouched rather
rem than guessed at. See CHANGELOG [0.0.41] for the full methodology.
if exist "$(ProjectDir)F4se-Data\Data\Meshes\LoadScreenArt" xcopy /Y /I "$(ProjectDir)F4se-Data\Data\Meshes\LoadScreenArt\*.nif" "$(FO4DataDir)\Meshes\LoadScreenArt\"
exit /b 0
      </Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
